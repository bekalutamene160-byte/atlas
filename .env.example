# ATLAS Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit the real .env file

# Required: Groq API key (get from console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# Required: Jina AI API key for embeddings (get from jina.ai)
JINA_API_KEY=jln_your_key_here

# Optional: Override model defaults (defaults shown)
# Planner makes retrieve/answer decisions — 20B is sufficient
ATLAS_PLANNER_MODEL=openai/gpt-oss-20b

# Synthesizer writes the final answer — 120B for quality
ATLAS_SYNTHESIZER_MODEL=openai/gpt-oss-120b

# Critic verifies grounding — 20B is sufficient
ATLAS_CRITIC_MODEL=openai/gpt-oss-20b

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Data directory (where the SQLite vector store lives)
ATLAS_DATA_DIR=./data
