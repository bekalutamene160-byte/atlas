# =============================================================================
# ATLAS Environment Variables
# =============================================================================


# --- Provider Selection ---
ATLAS_LLM_PROVIDER=mock
ATLAS_EMBEDDING_PROVIDER=local

# --- Groq (LLM) ---
# Get a free key at https://console.groq.com
ATLAS_GROQ_API_KEY=
ATLAS_GROQ_PLANNER_MODEL=llama-3.3-70b-versatile
ATLAS_GROQ_SYNTHESIZER_MODEL=llama-3.3-70b-versatile
ATLAS_GROQ_CRITIC_MODEL=llama-3.1-8b-instant

# --- HuggingFace (Embeddings, optional) ---
# Get a free token at https://huggingface.co/settings/tokens
ATLAS_HF_API_TOKEN=
ATLAS_HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ATLAS_LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ATLAS_EMBEDDING_DIMENSIONS=384

# --- Agent Bounds ---
ATLAS_MAX_AGENT_STEPS=8
ATLAS_RUN_TIMEOUT_SECONDS=60.0
ATLAS_MAX_TOKENS_PER_RUN=30000
ATLAS_MAX_TOOL_CALLS=12
ATLAS_STUCK_WINDOW=3

# --- Retrieval ---
ATLAS_CHUNK_SIZE=800
ATLAS_CHUNK_OVERLAP=100
ATLAS_RETRIEVAL_TOP_K=5
ATLAS_MIN_SIMILARITY=0.35

# --- Storage ---
ATLAS_DB_PATH=./data/atlas.db
ATLAS_CORPUS_PATH=./data/corpus
ATLAS_LOGS_PATH=./logs
